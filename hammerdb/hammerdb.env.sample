#!/usr/bin/env bash

# Copy to hammerdb/hammerdb.env before use; never load this template directly.
export HAMMERDB_HOME="${HAMMERDB_HOME:-/opt/HammerDB}"

# Connection variables
export HDB_SUPERUSER="${HDB_SUPERUSER:-$PGUSER}"
export HDB_SUPERUSER_PASSWORD="${HDB_SUPERUSER_PASSWORD-${PGPASSWORD:-}}"

# Citus specific configuration include load balancer
export HDB_CITUS_COMPAT="${HDB_CITUS_COMPAT:-false}"
export HDB_CITUS_LOADBALANCER_PORT="${HDB_CITUS_LOADBALANCER_PORT:-7432}"
export HDB_CITUS_DIRECT_WORKERS="${HDB_CITUS_DIRECT_WORKERS:-true}"

# Workload type and size
export HDB_WORKLOAD="${HDB_WORKLOAD:-tpcc}"
export HDB_WAREHOUSES="${HDB_WAREHOUSES:-20}"

# Data population and parallelism configuration
export HDB_FIRST_WAREHOUSE="${HDB_FIRST_WAREHOUSE:-1}"
export HDB_BUILD_VUS="${HDB_BUILD_VUS:-4}"

# Benchmark specific variables.
export HDB_RUN_VUS="${HDB_RUN_VUS:-4}"
export HDB_RAMPUP_MINUTES="${HDB_RAMPUP_MINUTES:-2}"
export HDB_DURATION_MINUTES="${HDB_DURATION_MINUTES:-5}"

# Distributed preparation requires the custom range/post-data HammerDB protocol.
export HDB_DISTRIBUTED_LOAD="${HDB_DISTRIBUTED_LOAD:-false}"

# Preparing does not drop existing data unless both settings explicitly allow it:
# HDB_RESET_SCHEMA=true and RUN_ALLOW_DESTRUCTIVE=true.
export HDB_RESET_SCHEMA="${HDB_RESET_SCHEMA:-false}"
export HDB_MAINTENANCE="${HDB_MAINTENANCE:-true}"
export HDB_VACUUM="${HDB_VACUUM:-true}"
