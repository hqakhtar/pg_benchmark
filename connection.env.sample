#!/usr/bin/env bash

# Copy to connection.env before use; never load this template directly.
# Canonical libpq target shared by SQL helpers and benchmark adapters.
export PGHOST="${PGHOST:-localhost}"
export PGPORT="${PGPORT:-5432}"
export PGDATABASE="${PGDATABASE:-postgres}"
export PGUSER="${PGUSER:-postgres}"
export PGSSLMODE="${PGSSLMODE:-prefer}"
export PGCONNECT_TIMEOUT="${PGCONNECT_TIMEOUT:-10}"
export PGMAINTENANCE_DB="${PGMAINTENANCE_DB:-postgres}"

# Use a quoted password in your private copy, or "" for password-file/trust auth.
export PGPASSWORD="${PGPASSWORD?Your password goes here: set PGPASSWORD (empty is allowed)}"

export PG_TARGET_MODE="${PG_TARGET_MODE:-existing}"
export PG_PSQL="${PG_PSQL:-psql}"

# Only used for an explicitly requested temporary local cluster.
export PG_CONFIG="${PG_CONFIG:-}"
export PG_SERVER_ENV_FILE="${PG_SERVER_ENV_FILE:-}"
export PG_INIT_SQL="${PG_INIT_SQL:-}"
export PG_REMOVE_DATA="${PG_REMOVE_DATA:-false}"
