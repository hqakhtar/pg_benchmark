#!/usr/bin/env bash

# Copy to run.env before use; never load this template directly.
export RUN_ITERATIONS="${RUN_ITERATIONS:-3}"
export RUN_OUTPUT_ROOT="${RUN_OUTPUT_ROOT:-./benchmark-results}"
export RUN_LABEL="${RUN_LABEL:-benchmark}"
# reuse: existing data; once: prepare before the run; each: prepare per iteration.
export RUN_PREPARE_MODE="${RUN_PREPARE_MODE:-reuse}"
export RUN_COOLDOWN_SECONDS="${RUN_COOLDOWN_SECONDS:-0}"
# Zero disables the per-adapter-operation timeout.
export RUN_TIMEOUT_SECONDS="${RUN_TIMEOUT_SECONDS:-0}"
# Permission only; the selected action or adapter still decides when to reset.
export RUN_ALLOW_DESTRUCTIVE="${RUN_ALLOW_DESTRUCTIVE:-false}"
