#!/usr/bin/env bash

# Copy to initdb.env and select that private file with PG_SERVER_ENV_FILE.
# Optional tuning for PG_TARGET_MODE=temporary; never applied to an existing server.
export PG_SERVER_OPTIONS="${PG_SERVER_OPTIONS:-} -c max_connections=100"
export PG_SERVER_OPTIONS="$PG_SERVER_OPTIONS -c shared_buffers=1GB"
export PG_SERVER_OPTIONS="$PG_SERVER_OPTIONS -c effective_cache_size=4GB"
export PG_SERVER_OPTIONS="$PG_SERVER_OPTIONS -c work_mem=16MB"
export PG_SERVER_OPTIONS="$PG_SERVER_OPTIONS -c wal_buffers=16MB"
export PG_SERVER_OPTIONS="$PG_SERVER_OPTIONS -c max_wal_size=16GB"
export PG_SERVER_OPTIONS="$PG_SERVER_OPTIONS -c min_wal_size=2GB"
export PG_SERVER_OPTIONS="$PG_SERVER_OPTIONS -c random_page_cost=1.1"
export PG_SERVER_OPTIONS="$PG_SERVER_OPTIONS -c effective_io_concurrency=200"
export PG_SERVER_OPTIONS="$PG_SERVER_OPTIONS -c checkpoint_timeout=30min"
