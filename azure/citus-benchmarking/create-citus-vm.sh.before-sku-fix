#!/usr/bin/env bash
#
# citus-benchmarking
#
# Creates a disposable Azure resource group containing an Ubuntu VM and its
# networking resources. It then configures a two-node Citus development/test
# cluster on that VM using Docker Compose:
#   - 1 coordinator
#   - 1 worker
#   - PostgreSQL 17
#   - Citus 14.2
#
# Run ./create-citus-vm.sh --help for all options.

set -Eeuo pipefail

# -----------------------------------------------------------------------------
# Defaults
# -----------------------------------------------------------------------------

PROJECT_NAME="citus-benchmarking"
DEFAULT_SUBSCRIPTION_ID="88abe223-c630-4f2c-8782-00bb5be874f6"
DEFAULT_LOCATION="East Asia"
DEFAULT_RESOURCE_GROUP_PREFIX="$PROJECT_NAME"
DEFAULT_VM_NAME="citus-benchmark"
DEFAULT_VM_SIZE="Standard_D4s_v5"
DEFAULT_ADMIN_USER="azureuser"
DEFAULT_SSH_PUBLIC_KEY="${HOME}/.ssh/id_ed25519.pub"

POSTGRES_USER="demouser"
CITUS_IMAGE="citusdata/citus:14.2-pg17"

# -----------------------------------------------------------------------------
# Runtime settings
# -----------------------------------------------------------------------------

SUBSCRIPTION_ID="$DEFAULT_SUBSCRIPTION_ID"
LOCATION_INPUT="$DEFAULT_LOCATION"
RESOURCE_GROUP=""
RESOURCE_GROUP_PREFIX="$DEFAULT_RESOURCE_GROUP_PREFIX"
VM_NAME="$DEFAULT_VM_NAME"
VM_SIZE="$DEFAULT_VM_SIZE"
ADMIN_USER="$DEFAULT_ADMIN_USER"
SSH_PUBLIC_KEY="$DEFAULT_SSH_PUBLIC_KEY"
SSH_PRIVATE_KEY=""
SOURCE_CIDR=""

DRY_RUN=false
SKIP_SKU_CHECK=false
KEEP_SETUP_SCRIPT=false

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
MAIN_BICEP="${SCRIPT_DIR}/main.bicep"
INFRASTRUCTURE_BICEP="${SCRIPT_DIR}/infrastructure.bicep"

TEMP_DIR=""
POSTGRES_PASSWORD=""
RESOURCE_GROUP_DEPLOYED=false
PUBLIC_IP=""

# -----------------------------------------------------------------------------
# Utility functions
# -----------------------------------------------------------------------------

log() {
    printf '[INFO] %s\n' "$*"
}

warn() {
    printf '[WARN] %s\n' "$*" >&2
}

fail() {
    printf '[ERROR] %s\n' "$*" >&2
    exit 1
}

separator() {
    printf '%s\n' '============================================================'
}

cleanup() {
    local rc=$?

    if [[ -n "$TEMP_DIR" && -d "$TEMP_DIR" ]]; then
        rm -rf -- "$TEMP_DIR"
    fi

    unset POSTGRES_PASSWORD

    if [[ $rc -ne 0 && "$RESOURCE_GROUP_DEPLOYED" == true ]]; then
        printf '\n[WARN] Deployment did not complete. Azure resources may remain.\n' >&2
        printf '[WARN] Cleanup command:\n' >&2
        printf '  az group delete --subscription "%s" --name "%s" --yes\n' \
            "$SUBSCRIPTION_ID" "$RESOURCE_GROUP" >&2
    fi
}

trap cleanup EXIT

usage() {
    cat <<EOF
Usage:
  $(basename "$0") [options]

Options:
  --dry-run
      Perform local validation and Azure Resource Manager what-if only.
      No Azure resources, Docker containers, or database resources are created.

  --subscription ID
      Azure subscription ID.
      Default: $DEFAULT_SUBSCRIPTION_ID

  --location LOCATION
      Azure canonical region name or display name.
      Examples: eastasia, "East Asia"
      Default: $DEFAULT_LOCATION

  --resource-group NAME
      Exact resource-group name. If omitted, the script creates:
      ${DEFAULT_RESOURCE_GROUP_PREFIX}-YYYYMMDD-HHMMSS

  --resource-group-prefix PREFIX
      Prefix used for an automatically generated resource-group name.
      Default: $DEFAULT_RESOURCE_GROUP_PREFIX

  --vm-name NAME
      Azure VM name.
      Default: $DEFAULT_VM_NAME

  --vm-size SKU
      Azure VM SKU.
      Default: $DEFAULT_VM_SIZE

  --admin-user USER
      Ubuntu administrator account.
      Default: $DEFAULT_ADMIN_USER

  --ssh-public-key PATH
      Existing SSH public-key file.
      Default: $DEFAULT_SSH_PUBLIC_KEY

  --ssh-private-key PATH
      Corresponding SSH private-key file.
      Default: public-key path with the trailing .pub removed

  --source-cidr CIDR
      IPv4 CIDR allowed to connect to SSH port 22 and PostgreSQL port 5432.
      Default: detect the caller's public IPv4 address and use /32

  --skip-sku-check
      Skip the subscription/region VM SKU availability check.

  --keep-setup-script
      Retain /tmp/citus-benchmarking-setup.sh on the VM after execution.
      The temporary password transfer file is always removed.

  --help, -h
      Show this help.

Examples:
  $(basename "$0") --dry-run

  $(basename "$0")

  $(basename "$0") \\
      --location "East Asia" \\
      --vm-size Standard_E4s_v5

  $(basename "$0") \\
      --resource-group citus-benchmarking-test \\
      --source-cidr 203.0.113.10/32
EOF
}

require_value() {
    local option="$1"
    local value="${2:-}"
    [[ -n "$value" ]] || fail "Option '$option' requires a value."
}

require_command() {
    local command_name="$1"
    command -v "$command_name" >/dev/null 2>&1 || \
        fail "Required command was not found: $command_name"
}

trim() {
    local value="$1"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s' "$value"
}

# Remove carriage-return characters that can appear when WSL invokes
# the Windows version of Azure CLI. Bash command substitution removes
# trailing line feeds, but it does not remove carriage returns.
strip_cr() {
    tr -d '\r'
}

validate_simple_name() {
    local label="$1"
    local value="$2"

    [[ "$value" =~ ^[a-zA-Z0-9._-]+$ ]] || \
        fail "$label contains unsupported characters: $value"
}

validate_ipv4_cidr() {
    local cidr="$1"
    local address prefix octet
    local -a octets

    [[ "$cidr" == */* ]] || return 1
    address="${cidr%/*}"
    prefix="${cidr##*/}"

    [[ "$prefix" =~ ^[0-9]+$ ]] || return 1
    (( prefix >= 0 && prefix <= 32 )) || return 1

    IFS='.' read -r -a octets <<<"$address"
    [[ "${#octets[@]}" -eq 4 ]] || return 1

    for octet in "${octets[@]}"; do
        [[ "$octet" =~ ^[0-9]{1,3}$ ]] || return 1
        (( 10#$octet >= 0 && 10#$octet <= 255 )) || return 1
    done
}

# -----------------------------------------------------------------------------
# Parse arguments
# -----------------------------------------------------------------------------

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        --subscription)
            require_value "$1" "${2:-}"
            SUBSCRIPTION_ID="$2"
            shift 2
            ;;
        --location)
            require_value "$1" "${2:-}"
            LOCATION_INPUT="$2"
            shift 2
            ;;
        --resource-group)
            require_value "$1" "${2:-}"
            RESOURCE_GROUP="$2"
            shift 2
            ;;
        --resource-group-prefix)
            require_value "$1" "${2:-}"
            RESOURCE_GROUP_PREFIX="$2"
            shift 2
            ;;
        --vm-name)
            require_value "$1" "${2:-}"
            VM_NAME="$2"
            shift 2
            ;;
        --vm-size)
            require_value "$1" "${2:-}"
            VM_SIZE="$2"
            shift 2
            ;;
        --admin-user)
            require_value "$1" "${2:-}"
            ADMIN_USER="$2"
            shift 2
            ;;
        --ssh-public-key)
            require_value "$1" "${2:-}"
            SSH_PUBLIC_KEY="$2"
            shift 2
            ;;
        --ssh-private-key)
            require_value "$1" "${2:-}"
            SSH_PRIVATE_KEY="$2"
            shift 2
            ;;
        --source-cidr)
            require_value "$1" "${2:-}"
            SOURCE_CIDR="$2"
            shift 2
            ;;
        --skip-sku-check)
            SKIP_SKU_CHECK=true
            shift
            ;;
        --keep-setup-script)
            KEEP_SETUP_SCRIPT=true
            shift
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        *)
            fail "Unknown argument: $1. Run with --help for usage."
            ;;
    esac
done

[[ $# -eq 0 ]] || fail "Unexpected positional arguments: $*"

# Expand a leading ~/ because quoted variables do not perform tilde expansion.
if [[ "$SSH_PUBLIC_KEY" == "~/"* ]]; then
    SSH_PUBLIC_KEY="${HOME}/${SSH_PUBLIC_KEY#~/}"
fi

if [[ -z "$SSH_PRIVATE_KEY" ]]; then
    SSH_PRIVATE_KEY="${SSH_PUBLIC_KEY%.pub}"
elif [[ "$SSH_PRIVATE_KEY" == "~/"* ]]; then
    SSH_PRIVATE_KEY="${HOME}/${SSH_PRIVATE_KEY#~/}"
fi

if [[ -z "$RESOURCE_GROUP" ]]; then
    RESOURCE_GROUP="${RESOURCE_GROUP_PREFIX}-$(date -u +%Y%m%d-%H%M%S)"
fi

# Explicit names make what-if output and cleanup easier to understand.
VNET_NAME="${VM_NAME}-vnet"
SUBNET_NAME="${VM_NAME}-subnet"
NSG_NAME="${VM_NAME}-nsg"
NIC_NAME="${VM_NAME}-nic"
PUBLIC_IP_NAME="${VM_NAME}-pip"
OS_DISK_NAME="${VM_NAME}-osdisk"

# -----------------------------------------------------------------------------
# Local validation
# -----------------------------------------------------------------------------

require_command az
require_command ssh
require_command scp
require_command curl

[[ -f "$MAIN_BICEP" ]] || fail "Bicep template not found: $MAIN_BICEP"
[[ -f "$INFRASTRUCTURE_BICEP" ]] || \
    fail "Bicep module not found: $INFRASTRUCTURE_BICEP"
[[ -f "$SSH_PUBLIC_KEY" ]] || fail "SSH public key not found: $SSH_PUBLIC_KEY"

if [[ "$DRY_RUN" == false && ! -f "$SSH_PRIVATE_KEY" ]]; then
    fail "SSH private key not found: $SSH_PRIVATE_KEY"
fi

validate_simple_name "Resource-group name" "$RESOURCE_GROUP"
validate_simple_name "VM name" "$VM_NAME"
validate_simple_name "VM size" "$VM_SIZE"
validate_simple_name "Administrator username" "$ADMIN_USER"

(( ${#RESOURCE_GROUP} <= 90 )) || fail "Resource-group name exceeds 90 characters."
(( ${#VM_NAME} <= 64 )) || fail "Linux VM name exceeds 64 characters."

SSH_PUBLIC_KEY_VALUE="$(<"$SSH_PUBLIC_KEY")"
[[ "$SSH_PUBLIC_KEY_VALUE" == ssh-* ]] || \
    fail "The public-key file does not appear to contain an OpenSSH public key."

TEMP_DIR="$(mktemp -d)"

log "Building the Bicep template to validate syntax..."
az bicep build \
    --file "$MAIN_BICEP" \
    --outfile "${TEMP_DIR}/main.json" \
    --only-show-errors

# -----------------------------------------------------------------------------
# Azure account validation
# -----------------------------------------------------------------------------

log "Checking Azure CLI authentication..."
az account show --output none 2>/dev/null || \
    fail "No active Azure CLI login was found. Run: az login"

log "Selecting Azure subscription: $SUBSCRIPTION_ID"
az account set --subscription "$SUBSCRIPTION_ID" --only-show-errors || \
    fail "The subscription is unavailable to the current Azure CLI identity."

SUBSCRIPTION_NAME="$(
    az account show \
        --subscription "$SUBSCRIPTION_ID" \
        --query name \
        --output tsv |
    strip_cr
)"

SUBSCRIPTION_STATE="$(
    az account show \
        --subscription "$SUBSCRIPTION_ID" \
        --query state \
        --output tsv |
    strip_cr
)"

TENANT_ID="$(
    az account show \
        --subscription "$SUBSCRIPTION_ID" \
        --query tenantId \
        --output tsv |
    strip_cr
)"

[[ -n "$SUBSCRIPTION_NAME" ]] || fail "Azure CLI returned no subscription name."
[[ "${SUBSCRIPTION_STATE,,}" == "enabled" ]] || \
    fail "Subscription '$SUBSCRIPTION_NAME' is '$SUBSCRIPTION_STATE', not Enabled."

# -----------------------------------------------------------------------------
# Region validation and normalization
# -----------------------------------------------------------------------------

LOCATION_INPUT="$(trim "$LOCATION_INPUT")"
[[ -n "$LOCATION_INPUT" ]] || fail "The location cannot be empty."

log "Validating Azure region: $LOCATION_INPUT"
LOCATION_RECORD="$(
    az account list-locations \
        --query '[].{Name:name,DisplayName:displayName}' \
        --output tsv |
    strip_cr |
    awk -F '\t' -v requested="$LOCATION_INPUT" '
        BEGIN { requested = tolower(requested) }
        tolower($1) == requested || tolower($2) == requested {
            print $1 "\t" $2
            exit
        }
    '
)"

if [[ -z "$LOCATION_RECORD" ]]; then
    printf "[ERROR] Region '%s' is not available for subscription '%s'.\n\n" \
        "$LOCATION_INPUT" "$SUBSCRIPTION_NAME" >&2
    printf 'Available physical regions include:\n' >&2
    az account list-locations \
        --query "[?metadata.regionType=='Physical'].{Name:name,DisplayName:displayName}" \
        --output table >&2
    exit 1
fi

LOCATION="$(printf '%s\n' "$LOCATION_RECORD" | cut -f1)"
LOCATION_DISPLAY_NAME="$(printf '%s\n' "$LOCATION_RECORD" | cut -f2-)"
[[ -n "$LOCATION" ]] || fail "Could not determine the canonical Azure region name."
[[ -n "$LOCATION_DISPLAY_NAME" ]] || LOCATION_DISPLAY_NAME="$LOCATION"

# -----------------------------------------------------------------------------
# VM SKU validation
# -----------------------------------------------------------------------------

if [[ "$SKIP_SKU_CHECK" == false ]]; then
    log "Validating VM SKU '$VM_SIZE' in '$LOCATION_DISPLAY_NAME'..."

    SKU_RECORD="$(
        az vm list-skus \
            --subscription "$SUBSCRIPTION_ID" \
            --location "$LOCATION" \
            --resource-type virtualMachines \
            --size "$VM_SIZE" \
            --all \
            --query "[?name=='$VM_SIZE'] | [0].[name,length(restrictions)]" \
            --output tsv |
        strip_cr
    )"

    [[ -n "$SKU_RECORD" ]] || \
        fail "VM SKU '$VM_SIZE' was not found in '$LOCATION_DISPLAY_NAME'."

    SKU_RESTRICTION_COUNT="$(printf '%s\n' "$SKU_RECORD" | cut -f2)"
    [[ "${SKU_RESTRICTION_COUNT:-0}" == "0" ]] || \
        fail "VM SKU '$VM_SIZE' is restricted in '$LOCATION_DISPLAY_NAME' for this subscription."
else
    warn "Skipping VM SKU availability validation."
fi

# -----------------------------------------------------------------------------
# Restrict inbound access to a validated IPv4 CIDR
# -----------------------------------------------------------------------------

if [[ -z "$SOURCE_CIDR" ]]; then
    log "Determining the caller's public IPv4 address..."
    CLIENT_IP="$(
        curl \
            --fail \
            --silent \
            --show-error \
            --max-time 10 \
            https://api.ipify.org 2>/dev/null || true
    )"
    [[ -n "$CLIENT_IP" ]] || \
        fail "Could not determine the public IPv4 address. Supply --source-cidr."
    SOURCE_CIDR="${CLIENT_IP}/32"
fi

validate_ipv4_cidr "$SOURCE_CIDR" || fail "Invalid IPv4 CIDR: $SOURCE_CIDR"

# -----------------------------------------------------------------------------
# Print the complete deployment target before any resource creation
# -----------------------------------------------------------------------------

if [[ "$DRY_RUN" == true ]]; then
    EXECUTION_MODE="DRY RUN: validation and ARM what-if only"
else
    EXECUTION_MODE="APPLY: create Azure resources and configure Citus"
fi

printf '\n'
separator
printf 'citus-benchmarking deployment plan\n'
separator
printf 'Execution mode     : %s\n' "$EXECUTION_MODE"
printf 'Subscription name  : %s\n' "$SUBSCRIPTION_NAME"
printf 'Subscription ID    : %s\n' "$SUBSCRIPTION_ID"
printf 'Subscription state : %s\n' "$SUBSCRIPTION_STATE"
printf 'Tenant ID          : %s\n' "$TENANT_ID"
printf 'Region display name: %s\n' "$LOCATION_DISPLAY_NAME"
printf 'Azure region name  : %s\n' "$LOCATION"
printf 'Resource group     : %s\n' "$RESOURCE_GROUP"
printf 'VM name            : %s\n' "$VM_NAME"
printf 'VM size            : %s\n' "$VM_SIZE"
printf 'Administrator      : %s\n' "$ADMIN_USER"
printf 'SSH public key     : %s\n' "$SSH_PUBLIC_KEY"
printf 'Inbound source     : %s\n' "$SOURCE_CIDR"
printf 'Virtual network    : %s\n' "$VNET_NAME"
printf 'Subnet             : %s\n' "$SUBNET_NAME"
printf 'Network security   : %s\n' "$NSG_NAME"
printf 'Public IP resource : %s\n' "$PUBLIC_IP_NAME"
printf 'PostgreSQL user    : %s\n' "$POSTGRES_USER"
printf 'Citus image        : %s\n' "$CITUS_IMAGE"
printf 'Citus topology     : 1 coordinator and 1 worker\n'
separator
printf '\n'

# Use exactly the same parameters for what-if and the real deployment.
ARM_PARAMETERS=(
    "resourceGroupName=$RESOURCE_GROUP"
    "location=$LOCATION"
    "vmName=$VM_NAME"
    "adminUsername=$ADMIN_USER"
    "vmSize=$VM_SIZE"
    "sshPublicKey=$SSH_PUBLIC_KEY_VALUE"
    "sourceAddressPrefix=$SOURCE_CIDR"
    "virtualNetworkName=$VNET_NAME"
    "subnetName=$SUBNET_NAME"
    "networkSecurityGroupName=$NSG_NAME"
    "networkInterfaceName=$NIC_NAME"
    "publicIpName=$PUBLIC_IP_NAME"
    "osDiskName=$OS_DISK_NAME"
)

# -----------------------------------------------------------------------------
# Dry run: ARM what-if is read-only with respect to target resources
# -----------------------------------------------------------------------------

if [[ "$DRY_RUN" == true ]]; then
    log "Running subscription-scope Azure Resource Manager what-if..."

    az deployment sub what-if \
        --subscription "$SUBSCRIPTION_ID" \
        --name "${VM_NAME}-what-if" \
        --location "$LOCATION" \
        --template-file "$MAIN_BICEP" \
        --parameters "${ARM_PARAMETERS[@]}" \
        --result-format FullResourcePayloads

    printf '\n'
    separator
    printf 'Dry run completed successfully\n'
    separator
    printf 'No resource group was created.\n'
    printf 'No Azure target resources were created.\n'
    printf 'No PostgreSQL password was requested.\n'
    printf 'No SSH connection was made.\n'
    printf 'No Docker or Citus resources were created.\n'
    exit 0
fi

# -----------------------------------------------------------------------------
# Prompt for the PostgreSQL bootstrap password only for a real deployment
# -----------------------------------------------------------------------------

read -rsp "Enter the PostgreSQL password for ${POSTGRES_USER}: " POSTGRES_PASSWORD
printf '\n'
read -rsp "Confirm the PostgreSQL password: " POSTGRES_PASSWORD_CONFIRM
printf '\n'

[[ -n "$POSTGRES_PASSWORD" ]] || fail "The PostgreSQL password cannot be empty."
[[ "$POSTGRES_PASSWORD" == "$POSTGRES_PASSWORD_CONFIRM" ]] || \
    fail "The PostgreSQL passwords do not match."
[[ "$POSTGRES_PASSWORD" != *$'\n'* && "$POSTGRES_PASSWORD" != *$'\r'* ]] || \
    fail "The PostgreSQL password cannot contain newline characters."
unset POSTGRES_PASSWORD_CONFIRM

# -----------------------------------------------------------------------------
# Deploy the resource group and all Azure resources
# -----------------------------------------------------------------------------

log "Creating the resource group and Azure infrastructure..."
az deployment sub create \
    --subscription "$SUBSCRIPTION_ID" \
    --name "${VM_NAME}-deployment" \
    --location "$LOCATION" \
    --template-file "$MAIN_BICEP" \
    --parameters "${ARM_PARAMETERS[@]}" \
    --only-show-errors \
    --output none
RESOURCE_GROUP_DEPLOYED=true

log "Waiting for the static public IP address..."
for _ in $(seq 1 30); do
    PUBLIC_IP="$(
        az network public-ip show \
            --subscription "$SUBSCRIPTION_ID" \
            --resource-group "$RESOURCE_GROUP" \
            --name "$PUBLIC_IP_NAME" \
            --query ipAddress \
            --output tsv 2>/dev/null |
        strip_cr || true
    )"
    [[ -n "$PUBLIC_IP" ]] && break
    sleep 5
done
[[ -n "$PUBLIC_IP" ]] || fail "Could not determine the VM public IP address."

# -----------------------------------------------------------------------------
# Wait for SSH
# -----------------------------------------------------------------------------

log "Waiting for SSH on ${PUBLIC_IP}..."
for attempt in $(seq 1 60); do
    if ssh \
        -i "$SSH_PRIVATE_KEY" \
        -o BatchMode=yes \
        -o ConnectTimeout=5 \
        -o StrictHostKeyChecking=accept-new \
        "${ADMIN_USER}@${PUBLIC_IP}" \
        'echo ready' >/dev/null 2>&1; then
        break
    fi

    [[ "$attempt" -lt 60 ]] || fail "SSH did not become available on ${PUBLIC_IP}."
    sleep 5
done

# -----------------------------------------------------------------------------
# Prepare non-persistent transfer files
# -----------------------------------------------------------------------------

REMOTE_SETUP_LOCAL="${TEMP_DIR}/citus-benchmarking-setup.sh"
PASSWORD_FILE_LOCAL="${TEMP_DIR}/postgres-password"
REMOTE_SETUP_PATH="/tmp/citus-benchmarking-setup.sh"
REMOTE_PASSWORD_PATH="/tmp/citus-benchmarking-password"

# Keep the password out of command-line arguments and ARM deployment history.
printf '%s' "$POSTGRES_PASSWORD" >"$PASSWORD_FILE_LOCAL"
chmod 600 "$PASSWORD_FILE_LOCAL"
unset POSTGRES_PASSWORD

cat >"$REMOTE_SETUP_LOCAL" <<'REMOTE_SCRIPT'
#!/usr/bin/env bash
# Configures a two-container Citus cluster on an existing Ubuntu VM.

set -Eeuo pipefail

POSTGRES_USER="demouser"
CITUS_IMAGE="citusdata/citus:14.2-pg17"
INSTALL_DIR="/opt/citus-benchmarking"
PASSWORD_TRANSFER_FILE="/tmp/citus-benchmarking-password"

[[ -r "$PASSWORD_TRANSFER_FILE" ]] || {
    echo "[ERROR] Password transfer file is missing or unreadable." >&2
    exit 1
}

POSTGRES_PASSWORD="$(<"$PASSWORD_TRANSFER_FILE")"
[[ -n "$POSTGRES_PASSWORD" ]] || {
    echo "[ERROR] PostgreSQL password is empty." >&2
    exit 1
}

# The transfer copy is removed immediately after reading it.
if command -v shred >/dev/null 2>&1; then
    shred -u "$PASSWORD_TRANSFER_FILE" || rm -f "$PASSWORD_TRANSFER_FILE"
else
    rm -f "$PASSWORD_TRANSFER_FILE"
fi

cleanup_secret_variable() {
    unset POSTGRES_PASSWORD
}
trap cleanup_secret_variable EXIT

echo "[INFO] Installing Docker and PostgreSQL client..."
sudo apt-get update
sudo DEBIAN_FRONTEND=noninteractive apt-get install -y \
    docker.io \
    postgresql-client

if ! sudo DEBIAN_FRONTEND=noninteractive apt-get install -y docker-compose-v2; then
    echo "[WARN] docker-compose-v2 was unavailable; trying docker-compose-plugin..."
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y docker-compose-plugin
fi

sudo systemctl enable --now docker
sudo docker compose version

sudo mkdir -p "$INSTALL_DIR"
sudo chown root:root "$INSTALL_DIR"
sudo chmod 700 "$INSTALL_DIR"

# Persist the password as a Docker Compose secret source so the containers can
# restart. The file is root-owned and mode 600. It is not passed through Compose
# variable interpolation or stored in Azure deployment history.
printf '%s' "$POSTGRES_PASSWORD" |
    sudo tee "$INSTALL_DIR/postgres-password" >/dev/null
sudo chown root:root "$INSTALL_DIR/postgres-password"
sudo chmod 600 "$INSTALL_DIR/postgres-password"

sudo tee "$INSTALL_DIR/compose.yaml" >/dev/null <<'COMPOSE_FILE'
services:
  coordinator:
    image: citusdata/citus:14.2-pg17
    container_name: citus-coordinator
    hostname: coordinator
    restart: unless-stopped
    ports:
      - "5432:5432"
    environment:
      POSTGRES_USER: demouser
      POSTGRES_PASSWORD_FILE: /run/secrets/postgres_password
      POSTGRES_DB: postgres
    secrets:
      - postgres_password
    volumes:
      - coordinator-data:/var/lib/postgresql/data
    networks:
      - citus-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U demouser -d postgres"]
      interval: 5s
      timeout: 5s
      retries: 30
      start_period: 10s

  worker:
    image: citusdata/citus:14.2-pg17
    container_name: citus-worker-1
    hostname: worker
    restart: unless-stopped
    environment:
      POSTGRES_USER: demouser
      POSTGRES_PASSWORD_FILE: /run/secrets/postgres_password
      POSTGRES_DB: postgres
    secrets:
      - postgres_password
    volumes:
      - worker-data:/var/lib/postgresql/data
    networks:
      - citus-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U demouser -d postgres"]
      interval: 5s
      timeout: 5s
      retries: 30
      start_period: 10s

networks:
  citus-network:
    driver: bridge

volumes:
  coordinator-data:
  worker-data:

secrets:
  postgres_password:
    file: /opt/citus-benchmarking/postgres-password
COMPOSE_FILE

sudo chown root:root "$INSTALL_DIR/compose.yaml"
sudo chmod 600 "$INSTALL_DIR/compose.yaml"

echo "[INFO] Pulling and starting the Citus containers..."
sudo docker compose --file "$INSTALL_DIR/compose.yaml" pull
sudo docker compose --file "$INSTALL_DIR/compose.yaml" up --detach

echo "[INFO] Waiting for coordinator and worker health checks..."
for attempt in $(seq 1 60); do
    COORDINATOR_STATUS="$(
        sudo docker inspect \
            --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' \
            citus-coordinator 2>/dev/null || true
    )"
    WORKER_STATUS="$(
        sudo docker inspect \
            --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' \
            citus-worker-1 2>/dev/null || true
    )"

    if [[ "$COORDINATOR_STATUS" == "healthy" && "$WORKER_STATUS" == "healthy" ]]; then
        break
    fi

    if [[ "$attempt" -eq 60 ]]; then
        echo "[ERROR] Citus containers did not become healthy." >&2
        sudo docker compose --file "$INSTALL_DIR/compose.yaml" ps
        sudo docker compose --file "$INSTALL_DIR/compose.yaml" logs --tail=100
        exit 1
    fi

    sleep 5
done

echo "[INFO] Registering the worker with the coordinator..."
sudo docker exec \
    -e PGPASSWORD="$POSTGRES_PASSWORD" \
    citus-coordinator \
    psql \
        --username "$POSTGRES_USER" \
        --dbname postgres \
        --set ON_ERROR_STOP=1 \
        --command "
            SELECT citus_add_node('worker', 5432)
            WHERE NOT EXISTS (
                SELECT 1
                FROM pg_dist_node
                WHERE nodename = 'worker'
                  AND nodeport = 5432
            );
        "

REGISTERED_WORKERS="$(
    sudo docker exec \
        -e PGPASSWORD="$POSTGRES_PASSWORD" \
        citus-coordinator \
        psql \
            --username "$POSTGRES_USER" \
            --dbname postgres \
            --tuples-only \
            --no-align \
            --set ON_ERROR_STOP=1 \
            --command "
                SELECT count(*)
                FROM pg_dist_node
                WHERE nodename = 'worker'
                  AND nodeport = 5432
                  AND isactive;
            "
)"

[[ "$REGISTERED_WORKERS" == "1" ]] || {
    echo "[ERROR] The Citus worker was not registered as active." >&2
    exit 1
}

echo "[INFO] Validating PostgreSQL and Citus versions and node metadata..."
sudo docker exec \
    -e PGPASSWORD="$POSTGRES_PASSWORD" \
    citus-coordinator \
    psql \
        --username "$POSTGRES_USER" \
        --dbname postgres \
        --set ON_ERROR_STOP=1 \
        --command "SELECT version();" \
        --command "SELECT citus_version();" \
        --command "
            SELECT nodeid, nodename, nodeport, noderole, isactive
            FROM pg_dist_node
            ORDER BY nodeid;
        "

sudo docker compose --file "$INSTALL_DIR/compose.yaml" ps
echo "[INFO] Citus cluster configuration completed."
REMOTE_SCRIPT

chmod 700 "$REMOTE_SETUP_LOCAL"

log "Uploading the setup and password transfer files..."
scp \
    -i "$SSH_PRIVATE_KEY" \
    -o BatchMode=yes \
    -o StrictHostKeyChecking=accept-new \
    "$REMOTE_SETUP_LOCAL" \
    "${ADMIN_USER}@${PUBLIC_IP}:${REMOTE_SETUP_PATH}"

scp \
    -i "$SSH_PRIVATE_KEY" \
    -o BatchMode=yes \
    -o StrictHostKeyChecking=accept-new \
    "$PASSWORD_FILE_LOCAL" \
    "${ADMIN_USER}@${PUBLIC_IP}:${REMOTE_PASSWORD_PATH}"

# Secure permissions before execution.
ssh \
    -i "$SSH_PRIVATE_KEY" \
    -o BatchMode=yes \
    -o StrictHostKeyChecking=accept-new \
    "${ADMIN_USER}@${PUBLIC_IP}" \
    "chmod 700 '$REMOTE_SETUP_PATH' && chmod 600 '$REMOTE_PASSWORD_PATH'"

log "Configuring the two-node Citus cluster..."
if [[ "$KEEP_SETUP_SCRIPT" == true ]]; then
    REMOTE_KEEP_SETUP_SCRIPT=true
else
    REMOTE_KEEP_SETUP_SCRIPT=false
fi

# The wrapper always deletes the password transfer file. It deletes the setup
# script unless --keep-setup-script was supplied.
ssh \
    -i "$SSH_PRIVATE_KEY" \
    -o BatchMode=yes \
    -o StrictHostKeyChecking=accept-new \
    "${ADMIN_USER}@${PUBLIC_IP}" \
    bash -s -- "$REMOTE_SETUP_PATH" "$REMOTE_PASSWORD_PATH" "$REMOTE_KEEP_SETUP_SCRIPT" <<'REMOTE_WRAPPER'
set -uo pipefail

setup_path="$1"
password_path="$2"
keep_setup_script="$3"

"$setup_path"
setup_rc=$?

# The setup script normally removes this file immediately after reading it.
# Remove it here as a fallback for early failures.
if [[ -e "$password_path" ]]; then
    if command -v shred >/dev/null 2>&1; then
        shred -u "$password_path" || rm -f "$password_path"
    else
        rm -f "$password_path"
    fi
fi

if [[ "$keep_setup_script" != "true" ]]; then
    if command -v shred >/dev/null 2>&1; then
        shred -u "$setup_path" || rm -f "$setup_path"
    else
        rm -f "$setup_path"
    fi
fi

exit "$setup_rc"
REMOTE_WRAPPER

